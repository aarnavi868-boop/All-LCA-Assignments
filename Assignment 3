   "outputs": [],
   "source": [
    "#Accept input\n",
    "s1 = float(input(\"Enter the first side: \"))\n",
    "s2 = float(input(\"Enter the second slide: \"))\n",
    "s3 = float(input(\"Enter the thirs side: \"))\n",
    "\n",
    "# define function\n",
    "def checkTriangle(a, b, c):\n",
    "    hypo = max(a,b,c)\n",
    "    if hypo == a:\n",
    "        if b**2 + c**2 == a**2:\n",
    "            return True\n",
    "        else:\n",
    "            return False\n",
    "\n",
    "    elif hypo == b:\n",
    "        if a**2 + c**2 == b**2:\n",
    "            return True\n",
    "        else:\n",
    "            return False\n",
    "\n",
    "    elif hypo == c:\n",
    "        if a**2 + b**2 == c**2:\n",
    "            return True\n",
    "        else:\n",
    "            return False\n",
    "\n",
    "# call function\n",
    "if checkTriangle(s1, s2, s3):\n",
    "    print(\"The triangle is right angled\")\n",
    "else:\n",
    "    print(\"The triangle is not right angled\")"
   ]
  }
