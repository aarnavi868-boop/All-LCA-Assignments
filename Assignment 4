   "source": [
    "matrix1=[\n",
    "    [1,2,3],\n",
    "    [4,5,6]\n",
    "]\n",
    "matrix2=[\n",
    "    [7,8,9],\n",
    "    [10,11,12]\n",
    "]\n",
    "#Intialising a result matrix with same size\n",
    "result=[\n",
    "    [0,0,0],\n",
    "    [0,0,0]\n",
    "]\n",
    "#perform matrix addition\n",
    "for i in range(len(matrix1)):\n",
    "    for j in range(len(matrix1[0])):\n",
    "        result[i][j]=matrix1[i][j]+matrix2[i][j]\n",
    "#display the result\n",
    "print(\"Matrix 1:\")\n",
    "for row in matrix1:\n",
    "    print(row)\n",
    "print(\"\\nMatrix 2:\")\n",
    "for row in matrix2:\n",
    "    print(row)\n",
    "\n",
    "print(\"\\nSum of Matrix 1 and Matrix 2:\")\n",
    "for row in result:\n",
    "    print(row)"
   ]
