    "string = input(\"Enter a string: \")\n",
    "\n",
    "valid = True\n",
    "\n",
    "for ch in string:\n",
    "    if not (('a' <= ch <= 'z') or ('A' <= ch <= 'Z') or ('0' <= ch <= '9')):\n",
    "        valid = False\n",
    "        break\n",
    "\n",
    "if valid:\n",
    "    print(\"The string contains only allowed characters.\")\n",
    "else:\n",
    "    print(\"The string contains invalid characters.\")"
